# ========================================================
# LUXERA PROVENANCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Create a local copy named '.env' or '.env.local' to customize.
# DO NOT commit real API keys or sensitive secrets to version control.

# --------------------------------------------------------
# 1. PRIMARY EXTERNAL SERVICE API KEYS
# --------------------------------------------------------

# [REQUIRED] Server-Side Google Gemini AI API Key
# Used for structured financial extraction, compliance explanation narratives, and vision OCR.
GEMINI_API_KEY=

# [OPTIONAL] Server-Side OCR.space API Key
# If configured, provides direct document parsing of PDFs, PNGs, and JPEGs.
# If missing, the engine automatically falls back to Gemini Vision OCR and native parsing.
OCR_SPACE_API_KEY=

# --------------------------------------------------------
# 2. LOCAL ENVIRONMENT & PERSISTENCE
# --------------------------------------------------------
# PORT=3000 (Defaults to port 3000. Do not override in containerized environments)
